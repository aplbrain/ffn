image {
  hdf5: "third_party/karlupia_inf/image_volume_inf1_zyx.h5:raw"
}
image_mean: 138
image_stddev: 54
checkpoint_interval: 1800
seed_policy: "PolicyPeaks"
model_checkpoint_path: "models/model.ckpt-2500000"
model_name: "convstack_3d.ConvStack3DFFNModel"
model_args: "{\"depth\": 12, \"fov_size\": [16, 16, 8], \"deltas\": [8, 8, 4]}"
segmentation_output_dir: "results/karlupia_inf/inf1_transposed"
inference_options {
  init_activation: 0.95
  pad_value: 0.05
  move_threshold: 0.9
  min_boundary_dist { x: 1 y: 1 z: 1}
  segment_threshold: 0.6
  min_segment_size: 500
}
