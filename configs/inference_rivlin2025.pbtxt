image {
  hdf5: "third_party/rivlin2025/image_volume.h5:raw"
}
# Replace these two with the actual mean/std of YOUR volume (critical).
image_mean: 150         # <- recompute if needed
image_stddev: 46        # <- recompute if needed

checkpoint_interval: 1800
seed_policy: "PolicyPeaks"

model_checkpoint_path: "models/fib25/model.ckpt-27465036"
model_name: "convstack_3d.ConvStack3DFFNModel"
model_args: "{\"depth\": 12, \"fov_size\": [33, 33, 33], \"deltas\": [4, 4, 4]}"

segmentation_output_dir: "results/rivlin2025/sample3"

inference_options {
  init_activation: 0.95
  pad_value: 0.01            # was 0.05
  move_threshold: 0.95       # was 0.9 (tune 0.97–0.99)
  min_boundary_dist { x: 1 y: 1 z: 1 }
  segment_threshold: 0.85     # was 0.6 (tune 0.85–0.95)
  min_segment_size: 500
  # if your branch supports seed options:
  # seed_score_threshold: 0.92
  # seed_min_distance: 4
}
